{
  "name": "midad",
  "version": "0.1.0",
  "description": "Open-source Arabic cursive handwriting animation engine modeled after Vara.js",
  "type": "module",
  "main": "./dist/midad.umd.js",
  "module": "./dist/midad.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/midad.es.js",
      "require": "./dist/midad.umd.js",
      "default": "./dist/midad.es.js"
    },
    "./fonts/*": "./dist/fonts/*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "arabic",
    "calligraphy",
    "handwriting",
    "animation",
    "svg",
    "vara",
    "rtl",
    "naskh"
  ],
  "author": "Midad Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AriachAmine/midad.git"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "harfbuzzjs": "^0.4.0",
    "jsdom": "^30.1.3",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "ssim.js": "^4.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
